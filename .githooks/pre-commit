#!/bin/bash
set -euo pipefail

mkdir -p .temp
temp_dir=$(mktemp -d .temp/pre-commit.XXXXXX)
trap 'rm -rf "$temp_dir"' EXIT

git diff --binary > "$temp_dir/diff-before.patch"

# 全 commit で dist を最新ソースから再ビルドして同期する運用。
# 依存バージョンが drift すると dist も動くため、dist 差分の再現性は lockfile (npm ci) /
# version range 管理側で担保する前提。
npm run build

npm run check:fix

# hook がワークツリーを変更しても、git commit が index.lock を保持しているため
# hook 内から git add はできない。コミット前から存在していた unstaged 変更と区別するため、
# 前後の diff を比較する。
git diff --binary > "$temp_dir/diff-after.patch"
if ! cmp -s "$temp_dir/diff-before.patch" "$temp_dir/diff-after.patch"; then
  echo ""
  echo "error: pre-commit hook changed files:"
  git diff --name-only
  echo ""
  echo "Review the changes and stage them before committing again:"
  echo "  git add -u && git commit"
  exit 1
fi

npm run check
npm run test
